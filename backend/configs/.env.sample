APP_NAME=bokdy
APP_ENV=development
APP_VERSION=0.1.0
DEVELOPMENT_MODE=development
ENABLE_API_DOCS=true

HTTP_HOST=0.0.0.0
HTTP_PORT=8088
SERVER_PORT=8088

DB_HOST=localhost
DB_PORT=5432
DB_USER=bokdy
DB_PASSWORD=bokdy
DB_NAME=bokdy
DB_SSLMODE=disable
DATABASE_URL=postgres://bokdy:bokdy@localhost:5432/bokdy?sslmode=disable

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

AUTH_ACCESS_TOKEN_SECRET=change-me-access-token-secret-min-32-chars
AUTH_REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-min-32-chars
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_SESSION_TTL=720h

BOOTSTRAP_ADMIN_EMAIL=admin@bokdy.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin123!
BOOTSTRAP_ADMIN_NAME="Platform Admin"

PLAYER_WEB_URL=http://localhost:3000
OWNER_WEB_URL=http://localhost:3001
ADMIN_WEB_URL=http://localhost:3002

OPENAPI_PATH=api/openapi/openapi.yaml
MAIL_PROVIDER_TYPE=log
