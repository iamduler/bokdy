Project Bokdy {
  database_type: "PostgreSQL"
}

//////////////////////////////////////////////////////////////
// CONVENTIONS
//////////////////////////////////////////////////////////////
//
// Cross-cutting rules for this ERD. Domain tables follow these unless a
// table Note documents an explicit exception.
//
// Language
// - Database, API and domain identifiers use American English.
// - Status / timestamp tokens use canceled / canceled_at (not cancelled).
// - L1 UI chrome (buttons, errors, status labels) is next-intl (en + vi), not DB.
//
// I18n
// - Display names: name_en + name_vi. Never name_th or jsonb locale maps.
// - L2 reference catalogs: both name_en and name_vi NOT NULL.
// - Exception: reference.locales uses name (English) + native_name (endonym),
//   not name_en/name_vi.
// - L3 tenant-authored: CHECK (name_en IS NOT NULL OR name_vi IS NOT NULL).
// - Locale 3+: {entity}_translations (locale_id FK), unique (entity_id, locale_id).
//   Keep name_en/name_vi. See reference.country_translations.
// - API: Accept-Language; missing → vi. Read DTOs return resolved name.
// - Owner edit DTOs expose name_en + name_vi.
// - Preference locale_id on user/tenant/customer does not override the header.
// - Person names and technical names stay a single column (see docs/architecture/i18n.md).
//
// Identifiers
// - OLTP PK is always id uuid (UUIDv7). Never use {entity}_id as PK.
// - 1:1 satellites use id PK + unique FK to the parent.
// - Composite PK is allowed only on pure join tables.
// - public_id varchar(26) (Crockford) is required on every aggregate exposed
//   by a public HTTP API. Never expose internal numeric IDs.
// - Exception: ISO reference catalogs may use a natural PK
//   (reference.currencies.code).
//
// Booleans
// - Columns start with is_ or has_. Never bare active / enabled / trusted.
//
// Time and money
// - All timestamps are timestamptz stored as UTC instants.
// - Public API emits RFC3339 UTC (`Z`). FE converts for display (browser TZ or
//   user_profiles.timezone). Branch timezone is for venue business clocks only.
// - Monetary amounts are decimal(18,2). Currency codes are ISO 4217.
//
// Multi-tenant
// - tenant_id is the isolation key. MVP: 1 tenant = 1 organization.
// - Soft-delete unique keys are partial: WHERE deleted_at IS NULL.
//
// Files
// - Uploaded bytes live in platform.files. Business tables store file_id.
// - External URLs (website, video) are varchar, not file_id.
// - File lifecycle: temporary -> active -> archived. Unreferenced temporary
//   files may be purged.
//
// Jobs
// - Asynq task types live in code. infrastructure.job_definitions is optional
//   discovery/override, not the source of truth for handlers.
//
// Out of scope (P3)
// - Do not merge reservation and booking aggregates.
// - Do not flatten resource -> court.
// - Do not encode every business rule as a DB constraint.
// - Phase 2 domains stay out: inventory, POS / cash shift, loyalty, ads, review.
//

//////////////////////////////////////////////////////////////
// INFRASTRUCTURE
//////////////////////////////////////////////////////////////

TableGroup "Infrastructure" {
  infrastructure.domain_events

  infrastructure.outbox_events
  infrastructure.inbox_events
  infrastructure.event_subscriptions

  infrastructure.idempotency_keys
  infrastructure.distributed_locks

  infrastructure.feature_flags
  infrastructure.tenant_feature_flags

  infrastructure.system_configs
  infrastructure.tenant_configs

  infrastructure.job_definitions
  infrastructure.job_schedules
  infrastructure.job_executions

  infrastructure.dead_letter_events
}

//////////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////////

Enum event_status {
  pending
  published
  failed
  ignored
}

Enum inbox_status {
  pending
  processed
  failed
  ignored
}

Enum event_subscription_status {
  active
  disabled
}

Enum lock_status {
  acquired
  released
  expired
}

Enum feature_flag_type {
  boolean
  integer
  string
  json
}

Enum job_schedule_type {
  once
  cron
  interval
}

Enum job_execution_status {
  queued
  running
  completed
  failed
  canceled
}

//////////////////////////////////////////////////////////////
// DOMAIN EVENTS
//////////////////////////////////////////////////////////////

Table infrastructure.domain_events {
  id uuid [pk]

  event_id uuid [not null]

  event_name varchar(255) [not null]

  aggregate_type varchar(100) [not null]

  aggregate_id uuid [not null]

  aggregate_version bigint [not null]

  event_version int [not null, default: 1]

  tenant_id uuid

  payload jsonb [not null]

  metadata jsonb

  occurred_at timestamptz [not null]

  created_at timestamptz [not null]

  indexes {
    event_id [unique]
    aggregate_type
    aggregate_id
    tenant_id
    event_name
    occurred_at
  }

  Note: 'Append-only domain event store.'
}

//////////////////////////////////////////////////////////////
// OUTBOX
//////////////////////////////////////////////////////////////

Table infrastructure.outbox_events {
  id uuid [pk]

  domain_event_id uuid [not null]

  topic varchar(255) [not null]

  partition_key varchar(255)

  status event_status [not null]

  retry_count int [not null, default: 0]

  available_at timestamptz [not null]

  published_at timestamptz

  last_error text

  created_at timestamptz [not null]

  indexes {
    domain_event_id [unique]
    status
    available_at
    topic
  }

  Note: 'Transactional Outbox.'
}

//////////////////////////////////////////////////////////////
// INBOX
//////////////////////////////////////////////////////////////

Table infrastructure.inbox_events {
  id uuid [pk]

  external_event_id varchar(255) [not null]

  source varchar(100) [not null]

  event_name varchar(255) [not null]

  payload jsonb [not null]

  status inbox_status [not null]

  processed_at timestamptz

  last_error text

  created_at timestamptz [not null]

  indexes {
    external_event_id
    source
    status
    (source, external_event_id) [unique]
  }

  Note: 'Idempotent consumer.'
}

//////////////////////////////////////////////////////////////
// SUBSCRIPTIONS
//////////////////////////////////////////////////////////////

Table infrastructure.event_subscriptions {
  id uuid [pk]

  event_name varchar(255) [not null]

  subscriber varchar(255) [not null]

  status event_subscription_status [not null]

  priority int [not null, default: 100]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    event_name
    subscriber
    (event_name, subscriber) [unique]
  }
}

//////////////////////////////////////////////////////////////
// IDEMPOTENCY
//////////////////////////////////////////////////////////////

Table infrastructure.idempotency_keys {
  id uuid [pk]

  tenant_id uuid

  idempotency_key varchar(255) [not null]

  request_hash varchar(255)

  response_status int

  response_body jsonb

  expires_at timestamptz [not null]

  created_at timestamptz [not null]

  indexes {
    tenant_id
    expires_at
    (tenant_id, idempotency_key) [unique]
  }

  Note: 'Stripe-style idempotency.'
}

//////////////////////////////////////////////////////////////
// DISTRIBUTED LOCKS
//////////////////////////////////////////////////////////////

Table infrastructure.distributed_locks {
  id uuid [pk]

  lock_key varchar(255) [not null]

  owner varchar(255)

  status lock_status [not null]

  acquired_at timestamptz [not null]

  expires_at timestamptz [not null]

  released_at timestamptz

  indexes {
    lock_key [unique]
    status
    expires_at
  }

  Note: 'Database fallback distributed lock.'
}

//////////////////////////////////////////////////////////////
// FEATURE FLAGS
//////////////////////////////////////////////////////////////

Table infrastructure.feature_flags {
  id uuid [pk]

  code varchar(100) [not null]

  name varchar(255) [not null]

  description text

  value_type feature_flag_type [not null]

  default_value jsonb

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    code [unique]
  }
}

Table infrastructure.tenant_feature_flags {
  id uuid [pk]

  tenant_id uuid [not null]

  feature_flag_id uuid [not null]

  value jsonb

  is_enabled boolean [not null, default: true]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    feature_flag_id
    (tenant_id, feature_flag_id) [unique]
  }
}

//////////////////////////////////////////////////////////////
// CONFIGURATION
//////////////////////////////////////////////////////////////

Table infrastructure.system_configs {
  id uuid [pk]

  config_key varchar(255) [not null]

  config_value jsonb

  description text

  updated_at timestamptz [not null]

  indexes {
    config_key [unique]
  }
}

Table infrastructure.tenant_configs {
  id uuid [pk]

  tenant_id uuid [not null]

  config_key varchar(255) [not null]

  config_value jsonb

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    (tenant_id, config_key) [unique]
  }
}

//////////////////////////////////////////////////////////////
// JOBS
//////////////////////////////////////////////////////////////

Table infrastructure.job_definitions {
  id uuid [pk]

  code varchar(100) [not null]

  name varchar(255) [not null]

  handler varchar(255) [not null]

  timeout_seconds int [not null]

  max_retries int [not null]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    code [unique]
  }

  Note: 'Optional discovery/override catalog. Asynq task types in code are the source of truth.'
}

Table infrastructure.job_schedules {
  id uuid [pk]

  job_definition_id uuid [not null]

  tenant_id uuid

  schedule_type job_schedule_type [not null]

  cron_expression varchar(255)

  interval_seconds bigint

  next_run_at timestamptz

  is_enabled boolean [not null, default: true]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    job_definition_id
    tenant_id
    is_enabled
    next_run_at
  }
}

Table infrastructure.job_executions {
  id uuid [pk]

  job_schedule_id uuid

  job_definition_id uuid [not null]

  status job_execution_status [not null]

  started_at timestamptz

  finished_at timestamptz

  duration_ms bigint

  retry_count int [not null, default: 0]

  error_message text

  payload jsonb

  created_at timestamptz [not null]

  indexes {
    job_definition_id
    job_schedule_id
    status
    started_at
  }
}

//////////////////////////////////////////////////////////////
// DEAD LETTER
//////////////////////////////////////////////////////////////

Table infrastructure.dead_letter_events {
  id uuid [pk]

  source varchar(100) [not null]

  reference_id uuid

  event_name varchar(255)

  payload jsonb

  error_message text

  retry_count int [not null]

  failed_at timestamptz [not null]

  indexes {
    source
    event_name
    failed_at
  }

  Note: 'Unrecoverable events.'
}

//////////////////////////////////////////////////////////////
// IDENTITY
//////////////////////////////////////////////////////////////

TableGroup "Identity" {
  identity.users
  identity.user_profiles

  identity.identities
  identity.identity_verifications

  identity.roles
  identity.permissions
  identity.role_permissions
  identity.user_roles

  identity.sessions
  identity.refresh_tokens
  identity.personal_access_tokens

  identity.password_credentials
  identity.password_reset_tokens

  identity.login_histories

  identity.user_devices

  identity.mfa_methods
  identity.mfa_recovery_codes
}

//////////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////////

Enum user_status {
  pending
  active
  suspended
  locked
  deleted
}

Enum gender {
  male
  female
  other
  undisclosed
}

Enum theme {
  light
  dark
  system
}

Enum date_format {
  dmy
  mdy
  ymd
}

Enum identity_provider {
  local
  google
  apple
  facebook
  github
  microsoft
  oidc
  saml
}

Enum verification_status {
  pending
  verified
  rejected
}

Enum role_scope {
  system
  tenant
}

Enum session_status {
  active
  expired
  revoked
}

Enum device_type {
  web
  android
  ios
  desktop
  api
}

Enum mfa_type {
  totp
  email
  sms
  passkey
}

//////////////////////////////////////////////////////////////
// USERS
//////////////////////////////////////////////////////////////

Table identity.users {
  id uuid [pk]

  public_id varchar(26) [not null]

  status user_status [not null]

  is_system_admin boolean [not null, default: false]

  last_login_at timestamptz

  email_verified_at timestamptz

  phone_verified_at timestamptz

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  deleted_at timestamptz

  indexes {
    public_id [unique]
    status
    last_login_at
  }
}

Table identity.user_profiles {
  id uuid [pk]

  user_id uuid [not null, unique]

  first_name varchar(100)

  last_name varchar(100)

  full_name varchar(255) [not null]

  display_name varchar(255)

  avatar_file_id uuid

  gender gender

  date_of_birth date

  timezone varchar(100)

  locale_id uuid

  country_id uuid

  preferred_currency_code varchar(3)

  theme theme [not null, default: 'system']

  date_format date_format [not null, default: 'dmy']

  created_at timestamptz [not null]

  updated_at timestamptz [not null]
}

//////////////////////////////////////////////////////////////
// IDENTITIES
//////////////////////////////////////////////////////////////

Table identity.identities {
  id uuid [pk]

  user_id uuid [not null]

  provider identity_provider [not null]

  provider_subject varchar(255) [not null]

  email varchar(255)

  phone varchar(30)

  is_primary boolean [not null, default: false]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    user_id
    provider
    (provider, provider_subject) [unique]
    phone [unique, note: 'partial WHERE phone IS NOT NULL']
  }
}

Table identity.identity_verifications {
  id uuid [pk]

  identity_id uuid [not null]

  status verification_status [not null]

  verified_at timestamptz

  expires_at timestamptz

  created_at timestamptz [not null]

  indexes {
    identity_id
    status
  }
}

//////////////////////////////////////////////////////////////
// RBAC
//////////////////////////////////////////////////////////////

Table identity.roles {
  id uuid [pk]

  code varchar(100) [not null]

  name_en varchar(255) [not null]

  name_vi varchar(255) [not null]

  scope role_scope [not null]

  description_en text

  description_vi text

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    code [unique]
    scope
  }
}

Table identity.permissions {
  id uuid [pk]

  code varchar(150) [not null]

  name_en varchar(255) [not null]

  name_vi varchar(255) [not null]

  description_en text

  description_vi text

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    code [unique]
  }
}

Table identity.role_permissions {
  role_id uuid [not null]

  permission_id uuid [not null]

  indexes {
    (role_id, permission_id) [pk]
  }
}

Table identity.user_roles {
  id uuid [pk]

  tenant_id uuid

  user_id uuid [not null]

  role_id uuid [not null]

  assigned_by uuid

  assigned_at timestamptz [not null]

  expires_at timestamptz

  indexes {
    tenant_id
    user_id
    role_id
    (tenant_id, user_id, role_id) [unique]
  }
}

//////////////////////////////////////////////////////////////
// PASSWORD
//////////////////////////////////////////////////////////////

Table identity.password_credentials {
  id uuid [pk]

  user_id uuid [not null, unique]

  password_hash text [not null]

  password_changed_at timestamptz

  password_expires_at timestamptz

  failed_attempts int [not null, default: 0]

  locked_until timestamptz

  updated_at timestamptz [not null]
}

Table identity.password_reset_tokens {
  id uuid [pk]

  user_id uuid [not null]

  token_hash varchar(255) [not null]

  expires_at timestamptz [not null]

  consumed_at timestamptz

  created_at timestamptz [not null]

  indexes {
    user_id
    expires_at
  }
}

//////////////////////////////////////////////////////////////
// SESSIONS
//////////////////////////////////////////////////////////////

Table identity.sessions {
  id uuid [pk]

  user_id uuid [not null]

  device_id uuid

  status session_status [not null]

  ip_address inet

  user_agent text

  last_activity_at timestamptz

  expires_at timestamptz [not null]

  created_at timestamptz [not null]

  indexes {
    user_id
    device_id
    status
    expires_at
  }
}

Table identity.refresh_tokens {
  id uuid [pk]

  session_id uuid [not null]

  token_hash varchar(255) [not null]

  expires_at timestamptz [not null]

  revoked_at timestamptz

  created_at timestamptz [not null]

  indexes {
    session_id
    expires_at
  }
}

Table identity.personal_access_tokens {
  id uuid [pk]

  user_id uuid [not null]

  name varchar(255) [not null]

  token_hash varchar(255) [not null]

  abilities jsonb

  last_used_at timestamptz

  expires_at timestamptz

  created_at timestamptz [not null]

  indexes {
    user_id
    expires_at
  }
}

//////////////////////////////////////////////////////////////
// LOGIN HISTORY
//////////////////////////////////////////////////////////////

Table identity.login_histories {
  id uuid [pk]

  user_id uuid [not null]

  session_id uuid

  provider identity_provider

  ip_address inet

  user_agent text

  is_success boolean [not null]

  reason varchar(255)

  created_at timestamptz [not null]

  indexes {
    user_id
    provider
    is_success
    created_at
  }
}

//////////////////////////////////////////////////////////////
// DEVICES
//////////////////////////////////////////////////////////////

Table identity.user_devices {
  id uuid [pk]

  user_id uuid [not null]

  device_type device_type [not null]

  device_name varchar(255)

  device_identifier varchar(255)

  is_trusted boolean [not null, default: false]

  last_seen_at timestamptz

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    user_id
    device_identifier
    is_trusted
  }
}

//////////////////////////////////////////////////////////////
// MFA
//////////////////////////////////////////////////////////////

Table identity.mfa_methods {
  id uuid [pk]

  user_id uuid [not null]

  method_type mfa_type [not null]

  secret text

  verified_at timestamptz

  is_default boolean [not null, default: false]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    user_id
    method_type
  }
}

Table identity.mfa_recovery_codes {
  id uuid [pk]

  mfa_method_id uuid [not null]

  code_hash varchar(255) [not null]

  used_at timestamptz

  created_at timestamptz [not null]

  indexes {
    mfa_method_id
    used_at
  }
}

//////////////////////////////////////////////////////////////
// ORGANIZATION
//////////////////////////////////////////////////////////////

TableGroup "Organization" {
  organization.tenants

  organization.organizations
  organization.organization_settings

  organization.business_units

  organization.locations
  organization.location_addresses
  organization.location_settings

  organization.staff_members
  organization.staff_profiles
  organization.staff_invitations

  organization.teams
  organization.team_members

  organization.organization_domains

  organization.tenant_subscriptions
  organization.tenant_usages
  organization.tenant_limits
}

//////////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////////

Enum tenant_status {
  trial
  active
  suspended
  canceled
}

Enum organization_status {
  active
  inactive
  suspended
  archived
}

Enum organization_type {
  company
  club
  school
  government
  individual
  other
}

Enum business_unit_status {
  active
  inactive
}

Enum location_status {
  active
  inactive
  maintenance
  archived
}

Enum staff_status {
  invited
  active
  suspended
  resigned
}

Enum invitation_status {
  pending
  accepted
  expired
  revoked
  rejected
}

Enum subscription_status {
  trial
  active
  past_due
  suspended
  canceled
}

//////////////////////////////////////////////////////////////
// TENANT
//////////////////////////////////////////////////////////////

Table organization.tenants {
  id uuid [pk]

  public_id varchar(26) [not null, unique]

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  slug varchar(150) [not null]

  status tenant_status [not null]

  timezone varchar(100)

  locale_id uuid

  currency varchar(10)

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    code [unique]
    slug [unique]
    status
  }
}

//////////////////////////////////////////////////////////////
// ORGANIZATION
//////////////////////////////////////////////////////////////

Table organization.organizations {
  id uuid [pk]

  public_id varchar(26) [not null, unique]

  tenant_id uuid [not null]

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  legal_name varchar(255)

  organization_type organization_type [not null]

  tax_code varchar(100)

  phone varchar(30)

  email varchar(255)

  website varchar(255)

  logo_file_id uuid

  status organization_status [not null]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  deleted_at timestamptz

  indexes {
    tenant_id
    status
    (tenant_id, code) [unique]
  }

  Note: 'Partial unique (tenant_id, code) WHERE deleted_at IS NULL.'
}

Table organization.organization_settings {
  id uuid [pk]

  organization_id uuid [not null, unique]

  booking_policy jsonb

  cancellation_policy jsonb

  operating_policy jsonb

  branding jsonb

  updated_at timestamptz [not null]

  Note: 'Policy JSON is versioned in domain docs. Not a free-form bag.'
}

//////////////////////////////////////////////////////////////
// BUSINESS UNIT
//////////////////////////////////////////////////////////////

Table organization.business_units {
  id uuid [pk]

  organization_id uuid [not null]

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  status business_unit_status [not null]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    organization_id
    status
    (organization_id, code) [unique]
  }
}

//////////////////////////////////////////////////////////////
// LOCATION
//////////////////////////////////////////////////////////////

Table organization.locations {
  id uuid [pk]

  public_id varchar(26) [not null, unique]

  business_unit_id uuid [not null]
  organization_id uuid [not null]

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  phone varchar(30)

  email varchar(255)

  timezone varchar(100)

  status location_status [not null]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  deleted_at timestamptz

  indexes {
    business_unit_id
    organization_id
    status
    (business_unit_id, code) [unique]
  }

  Note: 'Partial unique (business_unit_id, code) WHERE deleted_at IS NULL. Business name: Branch.'
}

Table organization.location_addresses {
  id uuid [pk]

  location_id uuid [not null, unique]

  country_id uuid

  state varchar(100)

  city varchar(100)

  district varchar(100)

  ward varchar(100)

  address_line_1 varchar(255)

  address_line_2 varchar(255)

  postal_code varchar(20)

  latitude decimal(10,7)

  longitude decimal(10,7)

  updated_at timestamptz [not null]
}

Table organization.location_settings {
  id uuid [pk]

  location_id uuid [not null, unique]

  booking_settings jsonb

  pricing_settings jsonb

  calendar_settings jsonb

  notification_settings jsonb

  updated_at timestamptz [not null]
}

//////////////////////////////////////////////////////////////
// STAFF
//////////////////////////////////////////////////////////////

Table organization.staff_members {
  id uuid [pk]

  organization_id uuid [not null]

  location_id uuid

  user_id uuid [not null]

  employee_code varchar(100)

  title varchar(255)

  status staff_status [not null]

  joined_at date

  left_at date

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    organization_id
    location_id
    user_id
    status
    (organization_id, employee_code) [unique]
  }
}

Table organization.staff_profiles {
  id uuid [pk]

  staff_member_id uuid [not null, unique]

  emergency_contact jsonb

  payroll jsonb

  employment jsonb

  metadata jsonb

  updated_at timestamptz [not null]
}

Table organization.staff_invitations {
  id uuid [pk]

  organization_id uuid [not null]

  email varchar(255) [not null]

  role_code varchar(100) [not null]

  invitation_token varchar(255) [not null]

  status invitation_status [not null]

  expires_at timestamptz [not null]

  invited_by uuid [not null]

  accepted_by uuid

  created_at timestamptz [not null]

  indexes {
    organization_id
    email
    status
  }
}

//////////////////////////////////////////////////////////////
// TEAM
//////////////////////////////////////////////////////////////

Table organization.teams {
  id uuid [pk]

  organization_id uuid [not null]

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  description_en text

  description_vi text

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    organization_id
    (organization_id, code) [unique]
  }
}

Table organization.team_members {
  team_id uuid [not null]

  staff_member_id uuid [not null]

  indexes {
    (team_id, staff_member_id) [pk]
  }
}

//////////////////////////////////////////////////////////////
// DOMAIN
//////////////////////////////////////////////////////////////

Table organization.organization_domains {
  id uuid [pk]

  organization_id uuid [not null]

  domain varchar(255) [not null]

  is_verified boolean [not null, default: false]

  is_primary boolean [not null, default: false]

  verified_at timestamptz

  created_at timestamptz [not null]

  indexes {
    domain [unique]
    organization_id
  }
}

//////////////////////////////////////////////////////////////
// TENANT BILLING
//////////////////////////////////////////////////////////////

Table organization.tenant_subscriptions {
  id uuid [pk]

  tenant_id uuid [not null]

  plan_code varchar(100) [not null]

  status subscription_status [not null]

  starts_at timestamptz [not null]

  expires_at timestamptz

  trial_ends_at timestamptz

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    status
  }
}

Table organization.tenant_limits {
  id uuid [pk]

  tenant_id uuid [not null]

  limit_key varchar(100) [not null]

  limit_value bigint [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    (tenant_id, limit_key) [unique]
  }
}

Table organization.tenant_usages {
  id uuid [pk]

  tenant_id uuid [not null]

  usage_key varchar(100) [not null]

  current_value bigint [not null, default: 0]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    (tenant_id, usage_key) [unique]
  }
}

//////////////////////////////////////////////////////////////
// CRM
//////////////////////////////////////////////////////////////

TableGroup "CRM" {
  crm.customers
  crm.customer_profiles

  crm.customer_contacts

  crm.customer_tags
  crm.customer_tag_assignments

  crm.customer_segments
  crm.customer_segment_members

  crm.customer_relationships

  crm.customer_addresses

  crm.customer_notes

  crm.customer_activities

  crm.customer_consents

  crm.customer_blacklists

  crm.customer_merge_histories
}

//////////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////////

Enum customer_status {
  lead
  active
  inactive
  blacklisted
  deleted
}

Enum customer_type {
  individual
  organization
}

Enum contact_type {
  email
  phone
  whatsapp
  zalo
  telegram
  facebook
  other
}

Enum relationship_type {
  parent
  child
  spouse
  coach
  guardian
  emergency_contact
  employee
}

Enum activity_type {
  created
  updated
  booking
  reservation
  payment
  refund
  membership
  check_in
  note
  login
  custom
}

Enum consent_type {
  terms
  privacy
  marketing_email
  marketing_sms
  marketing_push
}

Enum blacklist_scope {
  booking
  payment
  marketing
  system
}

//////////////////////////////////////////////////////////////
// CUSTOMER
//////////////////////////////////////////////////////////////

Table crm.customers {
  id uuid [pk]

  public_id varchar(26) [not null, unique]

  tenant_id uuid [not null]

  code varchar(100) [not null]

  customer_type customer_type [not null]

  status customer_status [not null]

  user_id uuid

  organization_name varchar(255)

  owner_staff_id uuid

  source varchar(100)

  acquired_at timestamptz

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  deleted_at timestamptz

  indexes {
    tenant_id
    status
    owner_staff_id
    user_id
    (tenant_id, code) [unique]
  }

  Note: 'Partial unique (tenant_id, code) WHERE deleted_at IS NULL.'
}

//////////////////////////////////////////////////////////////
// PROFILE
//////////////////////////////////////////////////////////////

Table crm.customer_profiles {
  id uuid [pk]

  customer_id uuid [not null, unique]

  first_name varchar(100)

  last_name varchar(100)

  full_name varchar(255)

  gender varchar(20)

  date_of_birth date

  avatar_file_id uuid

  occupation varchar(255)

  company varchar(255)

  tax_code varchar(100)

  preferred_locale_id uuid

  preferred_timezone varchar(100)

  metadata jsonb

  updated_at timestamptz [not null]
}

//////////////////////////////////////////////////////////////
// CONTACTS
//////////////////////////////////////////////////////////////

Table crm.customer_contacts {
  id uuid [pk]

  customer_id uuid [not null]

  contact_type contact_type [not null]

  value varchar(255) [not null]

  label varchar(100)

  is_verified boolean [not null, default: false]

  is_primary boolean [not null, default: false]

  verified_at timestamptz

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    customer_id
    contact_type
    value
  }
}

//////////////////////////////////////////////////////////////
// ADDRESS
//////////////////////////////////////////////////////////////

Table crm.customer_addresses {
  id uuid [pk]

  customer_id uuid [not null]

  label varchar(100)

  country_id uuid

  state varchar(100)

  city varchar(100)

  district varchar(100)

  ward varchar(100)

  address_line_1 varchar(255)

  address_line_2 varchar(255)

  postal_code varchar(20)

  latitude decimal(10,7)

  longitude decimal(10,7)

  is_default boolean [not null, default: false]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    customer_id
    is_default
  }
}

//////////////////////////////////////////////////////////////
// TAG
//////////////////////////////////////////////////////////////

Table crm.customer_tags {
  id uuid [pk]

  tenant_id uuid [not null]

  name_en varchar(100)

  name_vi varchar(100)

  color varchar(30)

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    (tenant_id, name_en) [unique]
    (tenant_id, name_vi) [unique]
  }
}

Table crm.customer_tag_assignments {
  customer_id uuid [not null]
  tag_id uuid [not null]

  indexes {
    (customer_id, tag_id) [pk]
  }
}

//////////////////////////////////////////////////////////////
// SEGMENT
//////////////////////////////////////////////////////////////

Table crm.customer_segments {
  id uuid [pk]

  tenant_id uuid [not null]

  name_en varchar(255)

  name_vi varchar(255)

  description_en text

  description_vi text

  filter_definition jsonb [not null]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
  }
}

Table crm.customer_segment_members {
  customer_segment_id uuid [not null]
  segment_id uuid [not null]
  customer_id uuid [not null]
  joined_at timestamptz [not null]

  indexes {
    (customer_segment_id, segment_id, customer_id) [pk]
  }
}

//////////////////////////////////////////////////////////////
// RELATIONSHIP
//////////////////////////////////////////////////////////////

Table crm.customer_relationships {
  id uuid [pk]

  customer_id uuid [not null]

  related_customer_id uuid [not null]

  relationship_type relationship_type [not null]

  created_at timestamptz [not null]

  indexes {
    customer_id
    related_customer_id
  }
}

//////////////////////////////////////////////////////////////
// NOTE
//////////////////////////////////////////////////////////////

Table crm.customer_notes {
  id uuid [pk]

  customer_id uuid [not null]

  staff_member_id uuid

  note text [not null]

  is_private boolean [not null, default: false]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    customer_id
    staff_member_id
  }
}

//////////////////////////////////////////////////////////////
// ACTIVITY
//////////////////////////////////////////////////////////////

Table crm.customer_activities {
  id uuid [pk]

  customer_id uuid [not null]

  activity_type activity_type [not null]

  actor_user_id uuid

  entity_type varchar(100)

  entity_id uuid

  payload jsonb

  occurred_at timestamptz [not null]

  indexes {
    customer_id
    activity_type
    entity_type
    entity_id
    occurred_at
  }

  Note: 'Append-only activity timeline.'
}

//////////////////////////////////////////////////////////////
// CONSENT
//////////////////////////////////////////////////////////////

Table crm.customer_consents {
  id uuid [pk]

  customer_id uuid [not null]

  consent_type consent_type [not null]

  is_accepted boolean [not null]

  accepted_at timestamptz

  expires_at timestamptz

  ip_address inet

  user_agent text

  created_at timestamptz [not null]

  indexes {
    customer_id
    consent_type
  }
}

//////////////////////////////////////////////////////////////
// BLACKLIST
//////////////////////////////////////////////////////////////

Table crm.customer_blacklists {
  id uuid [pk]

  customer_id uuid [not null]

  scope blacklist_scope [not null]

  reason text

  starts_at timestamptz

  ends_at timestamptz

  created_by uuid

  created_at timestamptz [not null]

  indexes {
    customer_id
    scope
  }
}

//////////////////////////////////////////////////////////////
// MERGE
//////////////////////////////////////////////////////////////

Table crm.customer_merge_histories {
  id uuid [pk]

  source_customer_id uuid [not null]

  target_customer_id uuid [not null]

  merged_by uuid [not null]

  merged_at timestamptz [not null]

  reason text

  indexes {
    source_customer_id
    target_customer_id
    merged_at
  }

  Note: 'Customer merge history.'
}

//////////////////////////////////////////////////////////////
// CATALOG
//////////////////////////////////////////////////////////////

TableGroup "Catalog" {
  catalog.sports

  catalog.service_categories

  catalog.services
  catalog.service_resources

  catalog.resource_categories

  catalog.resources
  catalog.resource_category_assignments

  catalog.resource_capabilities
  catalog.resource_capability_assignments

  catalog.resource_attributes
  catalog.resource_attribute_values

  catalog.resource_labels
  catalog.resource_label_assignments

  catalog.resource_groups
  catalog.resource_group_members

  catalog.resource_capacities

  catalog.resource_maintenances

  catalog.resource_costs

  catalog.resource_media
}

//////////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////////

Enum service_status {
  draft
  active
  inactive
  archived
}

Enum service_type {
  booking
  rental
  lesson
  membership
  event
}

Enum pricing_model {
  fixed
  duration
  dynamic
}

Enum resource_status {
  active
  inactive
  maintenance
  archived
}

Enum resource_category_status {
  active
  archived
}

Enum resource_type {
  court
  room
  coach
  equipment
  facility
}

Enum capability_level {
  beginner
  intermediate
  advanced
  professional
}

Enum maintenance_status {
  scheduled
  in_progress
  completed
  canceled
}

Enum cost_type {
  hourly
  daily
  monthly
  yearly
}

//////////////////////////////////////////////////////////////
// SPORTS
//////////////////////////////////////////////////////////////

Table catalog.sports {
  id uuid [pk]

  code varchar(100) [not null]

  name_en varchar(255) [not null]

  name_vi varchar(255) [not null]

  icon varchar(255)

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    code [unique]
  }
}

//////////////////////////////////////////////////////////////
// SERVICE CATEGORY
//////////////////////////////////////////////////////////////

Table catalog.service_categories {
  id uuid [pk]

  tenant_id uuid [not null]

  parent_id uuid

  sport_id uuid [not null]

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  description_en text

  description_vi text

  sort_order int [default: 0]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    parent_id
    sport_id
    (tenant_id, code) [unique]
  }
}

//////////////////////////////////////////////////////////////
// SERVICES
//////////////////////////////////////////////////////////////

Table catalog.services {
  id uuid [pk]

  public_id varchar(26) [not null, unique]

  tenant_id uuid [not null]

  service_category_id uuid

  sport_id uuid

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  description_en text

  description_vi text

  service_type service_type [not null]

  pricing_model pricing_model [not null]

  status service_status [not null]

  duration_minutes int

  min_booking_duration int

  max_booking_duration int

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  deleted_at timestamptz

  indexes {
    tenant_id
    sport_id
    service_category_id
    status
    (tenant_id, code) [unique]
  }

  Note: 'Partial unique (tenant_id, code) WHERE deleted_at IS NULL.'
}

Table catalog.service_resources {
  service_id uuid [not null]

  resource_id uuid [not null]

  is_required boolean [not null, default: true]

  quantity int [not null, default: 1]

  indexes {
    (service_id, resource_id) [pk]
  }
}

//////////////////////////////////////////////////////////////
// RESOURCE CATEGORY
//////////////////////////////////////////////////////////////

Table catalog.resource_categories {
  id uuid [pk]

  tenant_id uuid [not null]

  parent_id uuid

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  resource_type resource_type [not null]

  status resource_category_status [not null]

  slot_duration_minutes int [not null]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  deleted_at timestamptz

  indexes {
    tenant_id
    parent_id
    status
    (tenant_id, code) [unique, note: 'Partial WHERE deleted_at IS NULL']
  }

  Note: 'Business name: Court Type when resource_type = court. W4 adds status + slot_duration_minutes. DEF-20260814-01.'
}

//////////////////////////////////////////////////////////////
// RESOURCE
//////////////////////////////////////////////////////////////

Table catalog.resources {
  id uuid [pk]

  public_id varchar(26) [not null, unique]

  tenant_id uuid [not null]

  location_id uuid [not null]

  court_type_id uuid

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  resource_type resource_type [not null]

  parent_resource_id uuid

  status resource_status [not null]

  is_bookable boolean [not null, default: true]

  capacity int

  sort_order int [default: 0]

  metadata jsonb

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  deleted_at timestamptz

  indexes {
    tenant_id
    location_id
    parent_resource_id
    status
    (location_id, code) [unique, note: 'W4 courts: partial WHERE deleted_at IS NULL AND resource_type = court. DEF-20260814-01.']
  }

  Note: 'Business name: Court when resource_type = court. W4 requires court_type_id (BR-004). Code unique per branch, not tenant. DEF-20260814-01.'
}

Table catalog.resource_category_assignments {
  resource_id uuid [not null]

  resource_category_id uuid [not null]

  indexes {
    (resource_id, resource_category_id) [pk]
  }
}

//////////////////////////////////////////////////////////////
// CAPABILITY
//////////////////////////////////////////////////////////////

Table catalog.resource_capabilities {
  id uuid [pk]

  tenant_id uuid [not null]

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  description_en text

  description_vi text

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    (tenant_id, code) [unique]
  }
}

Table catalog.resource_capability_assignments {
  resource_id uuid [not null]

  capability_id uuid [not null]

  level capability_level

  indexes {
    (resource_id, capability_id) [pk]
  }
}

//////////////////////////////////////////////////////////////
// ATTRIBUTE
//////////////////////////////////////////////////////////////

Table catalog.resource_attributes {
  id uuid [pk]

  tenant_id uuid [not null]

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  value_type varchar(50) [not null]

  unit varchar(50)

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    (tenant_id, code) [unique]
  }
}

Table catalog.resource_attribute_values {
  id uuid [pk]

  resource_id uuid [not null]

  attribute_id uuid [not null]

  value jsonb [not null]

  indexes {
    resource_id
    attribute_id
    (resource_id, attribute_id) [unique]
  }
}

//////////////////////////////////////////////////////////////
// LABEL
//////////////////////////////////////////////////////////////

Table catalog.resource_labels {
  id uuid [pk]

  tenant_id uuid [not null]

  name_en varchar(100)

  name_vi varchar(100)

  color varchar(30)

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    (tenant_id, name_en) [unique]
    (tenant_id, name_vi) [unique]
  }
}

Table catalog.resource_label_assignments {
  resource_id uuid [not null]

  label_id uuid [not null]

  indexes {
    (resource_id, label_id) [pk]
  }
}

//////////////////////////////////////////////////////////////
// GROUP
//////////////////////////////////////////////////////////////

Table catalog.resource_groups {
  id uuid [pk]

  tenant_id uuid [not null]

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  description_en text

  description_vi text

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    (tenant_id, code) [unique]
  }
}

Table catalog.resource_group_members {
  group_id uuid [not null]
  resource_id uuid [not null]

  indexes {
    (group_id, resource_id) [pk]
  }
}

//////////////////////////////////////////////////////////////
// CAPACITY
//////////////////////////////////////////////////////////////

Table catalog.resource_capacities {
  id uuid [pk]

  resource_id uuid [not null]

  capacity_type varchar(100) [not null]

  capacity_value decimal(12,2) [not null]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    resource_id
  }
}

//////////////////////////////////////////////////////////////
// MAINTENANCE
//////////////////////////////////////////////////////////////

Table catalog.resource_maintenances {
  id uuid [pk]

  resource_id uuid [not null]

  status maintenance_status [not null]

  title varchar(255)

  description text

  started_at timestamptz

  completed_at timestamptz

  next_maintenance_at timestamptz

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    resource_id
    status
    next_maintenance_at
  }
}

//////////////////////////////////////////////////////////////
// COST
//////////////////////////////////////////////////////////////

Table catalog.resource_costs {
  id uuid [pk]

  resource_id uuid [not null]

  cost_type cost_type [not null]

  amount decimal(18,2) [not null]

  currency varchar(10) [not null]

  effective_from timestamptz [not null]

  effective_to timestamptz

  created_at timestamptz [not null]

  indexes {
    resource_id
    effective_from
  }
}

//////////////////////////////////////////////////////////////
// MEDIA
//////////////////////////////////////////////////////////////

Table catalog.resource_media {
  id uuid [pk]

  resource_id uuid [not null]

  file_id uuid [not null]

  is_primary boolean [not null, default: false]

  sort_order int [default: 0]

  created_at timestamptz [not null]

  indexes {
    resource_id
    is_primary
  }
}

//////////////////////////////////////////////////////////////
// SCHEDULING
//////////////////////////////////////////////////////////////

TableGroup "Scheduling" {
  scheduling.business_hours

  scheduling.calendar_rules
  scheduling.calendar_rule_resources

  scheduling.calendar_exceptions
  scheduling.calendar_holidays

  scheduling.availability_rules

  scheduling.resource_availability

  scheduling.resource_blocks

  scheduling.resource_maintenance_windows

  scheduling.availability_projections

  scheduling.time_slots
}

//////////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////////

Enum recurrence_type {
  none
  daily
  weekly
  monthly
  yearly
}

Enum availability_type {
  available
  unavailable
}

Enum block_type {
  reservation
  booking
  maintenance
  holiday
  manual
  system
}

Enum projection_status {
  pending
  generated
  expired
}

//////////////////////////////////////////////////////////////
// BUSINESS HOURS
//////////////////////////////////////////////////////////////

Table scheduling.business_hours {
  id uuid [pk]

  location_id uuid [not null]

  weekday smallint [not null]

  opens_at time [not null]

  closes_at time [not null]

  is_closed boolean [not null, default: false]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    location_id
    weekday
    (location_id, weekday) [unique]
  }
}

//////////////////////////////////////////////////////////////
// CALENDAR RULES
//////////////////////////////////////////////////////////////

Table scheduling.calendar_rules {
  id uuid [pk]

  tenant_id uuid [not null]

  name_en varchar(255)

  name_vi varchar(255)

  recurrence recurrence_type [not null]

  rrule text

  starts_at timestamptz [not null]

  ends_at timestamptz

  timezone varchar(100)

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    starts_at
  }
}

Table scheduling.calendar_rule_resources {
  calendar_rule_id uuid [not null]

  resource_id uuid [not null]

  indexes {
    (calendar_rule_id, resource_id) [pk]
  }
}

//////////////////////////////////////////////////////////////
// EXCEPTIONS
//////////////////////////////////////////////////////////////

Table scheduling.calendar_exceptions {
  id uuid [pk]

  calendar_rule_id uuid [not null]

  exception_date date [not null]

  created_at timestamptz [not null]

  indexes {
    calendar_rule_id
    exception_date
    (calendar_rule_id, exception_date) [unique]
  }
}

//////////////////////////////////////////////////////////////
// HOLIDAYS
//////////////////////////////////////////////////////////////

Table scheduling.calendar_holidays {
  id uuid [pk]

  tenant_id uuid [not null]

  location_id uuid

  name_en varchar(255)

  name_vi varchar(255)

  starts_at timestamptz [not null]

  ends_at timestamptz [not null]

  is_closed boolean [not null, default: true]

  opens_at time

  closes_at time

  created_at timestamptz [not null]

  indexes {
    tenant_id
    location_id
    starts_at
  }

  Note: 'W5 special schedule. Default is_closed=true (branch closed for window). Optional opens_at/closes_at when is_closed=false.'
}

//////////////////////////////////////////////////////////////
// AVAILABILITY RULES
//////////////////////////////////////////////////////////////

Table scheduling.availability_rules {
  id uuid [pk]

  resource_id uuid [not null]

  availability_type availability_type [not null]

  recurrence recurrence_type [not null]

  rrule text

  starts_at timestamptz [not null]

  ends_at timestamptz

  priority int [not null, default: 100]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    resource_id
    priority
  }
}

//////////////////////////////////////////////////////////////
// RESOURCE AVAILABILITY
//////////////////////////////////////////////////////////////

Table scheduling.resource_availability {
  id uuid [pk]

  resource_id uuid [not null]

  starts_at timestamptz [not null]

  ends_at timestamptz [not null]

  availability_type availability_type [not null]

  source varchar(100)

  created_at timestamptz [not null]

  indexes {
    resource_id
    starts_at
    ends_at
  }
}

//////////////////////////////////////////////////////////////
// BLOCKS
//////////////////////////////////////////////////////////////

Table scheduling.resource_blocks {
  id uuid [pk]

  resource_id uuid [not null]

  block_type block_type [not null]

  reference_type varchar(100)

  reference_id uuid

  starts_at timestamptz [not null]

  ends_at timestamptz [not null]

  reason text

  created_at timestamptz [not null]

  indexes {
    resource_id
    block_type
    starts_at
    ends_at
    reference_type
    reference_id
  }

  Note: 'Source of truth for occupied time.'
}

//////////////////////////////////////////////////////////////
// MAINTENANCE WINDOWS
//////////////////////////////////////////////////////////////

Table scheduling.resource_maintenance_windows {
  id uuid [pk]

  resource_id uuid [not null]

  maintenance_id uuid

  starts_at timestamptz [not null]

  ends_at timestamptz [not null]

  created_at timestamptz [not null]

  indexes {
    resource_id
    starts_at
  }
}

//////////////////////////////////////////////////////////////
// AVAILABILITY PROJECTION
//////////////////////////////////////////////////////////////

Table scheduling.availability_projections {
  id uuid [pk]

  resource_id uuid [not null]

  projection_date date [not null]

  available_minutes int [not null]

  occupied_minutes int [not null]

  status projection_status [not null]

  generated_at timestamptz [not null]

  indexes {
    resource_id
    projection_date
    (resource_id, projection_date) [unique]
  }

  Note: 'Read model generated asynchronously.'
}

//////////////////////////////////////////////////////////////
// TIME SLOT
//////////////////////////////////////////////////////////////

Table scheduling.time_slots {
  id uuid [pk]

  resource_id uuid [not null]

  starts_at timestamptz [not null]

  ends_at timestamptz [not null]

  is_available boolean [not null]

  source varchar(100)

  projection_id uuid

  generated_at timestamptz [not null]

  indexes {
    resource_id
    starts_at
    is_available
    (resource_id, starts_at) [unique]
  }

  Note: 'Pre-generated booking slots for fast search.'
}

//////////////////////////////////////////////////////////////
// PRICING
//////////////////////////////////////////////////////////////

TableGroup "Pricing" {
  pricing.price_lists

  pricing.price_versions

  pricing.pricing_rule_sets

  pricing.pricing_rules

  pricing.pricing_conditions

  pricing.pricing_adjustments

  pricing.taxes

  pricing.service_prices

  pricing.resource_prices
}

//////////////////////////////////////////////////////////////
// PROMOTION
//////////////////////////////////////////////////////////////

TableGroup "Promotion" {
  promotion.campaigns

  promotion.coupons

  promotion.vouchers

  promotion.promotion_rules

  promotion.promotion_redemptions
}

//////////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////////

Enum price_list_status {
  draft
  active
  archived
}

Enum price_version_status {
  draft
  active
  retired
}

Enum pricing_scope {
  service
  resource
  booking
}

Enum pricing_rule_type {
  fixed
  percentage
  formula
}

Enum adjustment_type {
  surcharge
  discount
}

Enum tax_type {
  inclusive
  exclusive
}

Enum campaign_status {
  draft
  scheduled
  active
  paused
  expired
}

Enum coupon_type {
  percentage
  fixed
}

Enum voucher_status {
  available
  redeemed
  expired
  canceled
}

//////////////////////////////////////////////////////////////
// PRICE LIST
//////////////////////////////////////////////////////////////

Table pricing.price_lists {
  id uuid [pk]

  tenant_id uuid [not null]

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  currency varchar(10) [not null]

  status price_list_status [not null]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    status
    (tenant_id, code) [unique]
  }
}

//////////////////////////////////////////////////////////////
// PRICE VERSION
//////////////////////////////////////////////////////////////

Table pricing.price_versions {
  id uuid [pk]

  price_list_id uuid [not null]

  version int [not null]

  status price_version_status [not null]

  effective_from timestamptz [not null]

  effective_to timestamptz

  published_at timestamptz

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    price_list_id
    status
    effective_from
    (price_list_id, version) [unique]
  }
}

//////////////////////////////////////////////////////////////
// RULE SET
//////////////////////////////////////////////////////////////

Table pricing.pricing_rule_sets {
  id uuid [pk]

  price_version_id uuid [not null]

  name_en varchar(255)

  name_vi varchar(255)

  priority int [not null, default: 100]

  is_active boolean [not null, default: true]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    price_version_id
    priority
  }
}

//////////////////////////////////////////////////////////////
// RULE
//////////////////////////////////////////////////////////////

Table pricing.pricing_rules {
  id uuid [pk]

  rule_set_id uuid [not null]

  scope pricing_scope [not null]

  rule_type pricing_rule_type [not null]

  expression text

  priority int [not null, default: 100]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    rule_set_id
    priority
  }
}

//////////////////////////////////////////////////////////////
// CONDITION
//////////////////////////////////////////////////////////////

Table pricing.pricing_conditions {
  id uuid [pk]

  pricing_rule_id uuid [not null]

  field varchar(100) [not null]

  operator varchar(30) [not null]

  value jsonb [not null]

  indexes {
    pricing_rule_id
  }
}

//////////////////////////////////////////////////////////////
// ADJUSTMENT
//////////////////////////////////////////////////////////////

Table pricing.pricing_adjustments {
  id uuid [pk]

  pricing_rule_id uuid [not null]

  adjustment_type adjustment_type [not null]

  value decimal(18,2) [not null]

  description varchar(255)

  indexes {
    pricing_rule_id
  }
}

//////////////////////////////////////////////////////////////
// TAX
//////////////////////////////////////////////////////////////

Table pricing.taxes {
  id uuid [pk]

  tenant_id uuid [not null]

  code varchar(50) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  tax_type tax_type [not null]

  rate decimal(8,4) [not null]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    (tenant_id, code) [unique]
  }
}

//////////////////////////////////////////////////////////////
// SERVICE PRICE
//////////////////////////////////////////////////////////////

Table pricing.service_prices {
  id uuid [pk]

  price_version_id uuid [not null]

  service_id uuid [not null]

  amount decimal(18,2) [not null]

  created_at timestamptz [not null]

  indexes {
    service_id
    price_version_id
    (price_version_id, service_id) [unique]
  }
}

//////////////////////////////////////////////////////////////
// RESOURCE PRICE
//////////////////////////////////////////////////////////////

Table pricing.resource_prices {
  id uuid [pk]

  price_version_id uuid [not null]

  resource_id uuid [not null]

  amount decimal(18,2) [not null]

  created_at timestamptz [not null]

  indexes {
    resource_id
    price_version_id
    (price_version_id, resource_id) [unique]
  }
}

//////////////////////////////////////////////////////////////
// PROMOTION
//////////////////////////////////////////////////////////////

Table promotion.campaigns {
  id uuid [pk]

  tenant_id uuid [not null]

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  status campaign_status [not null]

  starts_at timestamptz

  ends_at timestamptz

  budget decimal(18,2)

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    status
    (tenant_id, code) [unique]
  }
}

//////////////////////////////////////////////////////////////
// COUPON
//////////////////////////////////////////////////////////////

Table promotion.coupons {
  id uuid [pk]

  campaign_id uuid [not null]

  code varchar(100) [not null]

  coupon_type coupon_type [not null]

  value decimal(18,2) [not null]

  usage_limit int

  used_count int [not null, default: 0]

  starts_at timestamptz

  ends_at timestamptz

  created_at timestamptz [not null]

  indexes {
    campaign_id
    code [unique]
  }
}

//////////////////////////////////////////////////////////////
// VOUCHER
//////////////////////////////////////////////////////////////

Table promotion.vouchers {
  id uuid [pk]

  coupon_id uuid [not null]
  campaign_id uuid [not null]

  customer_id uuid

  code varchar(100) [not null]

  status voucher_status [not null]

  redeemed_at timestamptz

  expires_at timestamptz

  created_at timestamptz [not null]

  indexes {
    coupon_id
    campaign_id
    customer_id
    code [unique]
    status
  }
}

//////////////////////////////////////////////////////////////
// PROMOTION RULE
//////////////////////////////////////////////////////////////

Table promotion.promotion_rules {
  id uuid [pk]

  campaign_id uuid [not null]

  priority int [not null, default: 100]

  conditions jsonb

  rewards jsonb

  created_at timestamptz [not null]

  indexes {
    campaign_id
    priority
  }
}

//////////////////////////////////////////////////////////////
// REDEMPTION
//////////////////////////////////////////////////////////////

Table promotion.promotion_redemptions {
  id uuid [pk]

  voucher_id uuid [not null]

  booking_id uuid
  coupon_id uuid

  customer_id uuid

  discount_amount decimal(18,2) [not null]

  redeemed_at timestamptz [not null]

  indexes {
    voucher_id
    booking_id
    coupon_id
    customer_id
  }

  Note: 'Immutable redemption history.'
}

//////////////////////////////////////////////////////////////
// RESERVATION
//////////////////////////////////////////////////////////////

TableGroup "Reservation" {
  reservation.reservations

  reservation.reservation_items

  reservation.reservation_resources

  reservation.reservation_holds

  reservation.reservation_guests

  reservation.reservation_notes

  reservation.reservation_status_histories

  reservation.reservation_expirations
}

//////////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////////

Enum reservation_status {
  draft
  pending
  confirmed
  expired
  canceled
  completed
}

Enum reservation_source {
  web
  mobile
  admin
  api
  integration
}

Enum reservation_hold_status {
  active
  released
  expired
  converted
}

//////////////////////////////////////////////////////////////
// RESERVATION
//////////////////////////////////////////////////////////////

Table reservation.reservations {
  id uuid [pk]

  public_id varchar(26) [not null, unique]

  tenant_id uuid [not null]

  reservation_no varchar(50) [not null]

  customer_id uuid [not null]

  source reservation_source [not null]

  status reservation_status [not null]

  currency varchar(10) [not null]

  subtotal decimal(18,2) [not null, default: 0]

  discount_amount decimal(18,2) [not null, default: 0]

  tax_amount decimal(18,2) [not null, default: 0]

  total_amount decimal(18,2) [not null, default: 0]

  note text

  expires_at timestamptz

  confirmed_at timestamptz

  canceled_at timestamptz

  created_by uuid

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    customer_id
    status
    expires_at
    confirmed_at
    reservation_no [unique]
  }
}

//////////////////////////////////////////////////////////////
// ITEMS
//////////////////////////////////////////////////////////////

Table reservation.reservation_items {
  id uuid [pk]

  reservation_id uuid [not null]

  service_id uuid [not null]

  quantity int [not null, default: 1]

  starts_at timestamptz [not null]

  ends_at timestamptz [not null]

  duration_minutes int [not null]

  unit_price decimal(18,2) [not null]

  subtotal decimal(18,2) [not null]

  discount_amount decimal(18,2) [not null, default: 0]

  tax_amount decimal(18,2) [not null, default: 0]

  total_amount decimal(18,2) [not null]

  created_at timestamptz [not null]

  indexes {
    reservation_id
    service_id
    starts_at
  }
}

//////////////////////////////////////////////////////////////
// RESERVED RESOURCES
//////////////////////////////////////////////////////////////

Table reservation.reservation_resources {
  id uuid [pk]

  reservation_item_id uuid [not null]

  resource_id uuid [not null]

  quantity int [not null, default: 1]

  starts_at timestamptz [not null]

  ends_at timestamptz [not null]

  created_at timestamptz [not null]

  indexes {
    reservation_item_id
    resource_id
    starts_at
  }
}

//////////////////////////////////////////////////////////////
// HOLD
//////////////////////////////////////////////////////////////

Table reservation.reservation_holds {
  id uuid [pk]

  reservation_id uuid [not null]

  resource_id uuid [not null]

  status reservation_hold_status [not null]

  lock_key varchar(255)

  starts_at timestamptz [not null]

  ends_at timestamptz [not null]

  expires_at timestamptz [not null]

  released_at timestamptz

  created_at timestamptz [not null]

  indexes {
    reservation_id
    resource_id
    status
    expires_at
  }

  Note: 'Temporary resource lock before booking confirmation.'
}

//////////////////////////////////////////////////////////////
// GUESTS
//////////////////////////////////////////////////////////////

Table reservation.reservation_guests {
  id uuid [pk]

  reservation_item_id uuid [not null]

  customer_id uuid

  full_name varchar(255) [not null]

  phone varchar(30)

  email varchar(255)

  created_at timestamptz [not null]

  indexes {
    reservation_item_id
    customer_id
  }
}

//////////////////////////////////////////////////////////////
// NOTES
//////////////////////////////////////////////////////////////

Table reservation.reservation_notes {
  id uuid [pk]

  reservation_id uuid [not null]

  created_by uuid

  is_internal boolean [not null, default: true]

  note text [not null]

  created_at timestamptz [not null]

  indexes {
    reservation_id
    created_by
  }
}

//////////////////////////////////////////////////////////////
// STATUS HISTORY
//////////////////////////////////////////////////////////////

Table reservation.reservation_status_histories {
  id uuid [pk]

  reservation_id uuid [not null]

  from_status reservation_status

  to_status reservation_status [not null]

  changed_by uuid

  reason text

  created_at timestamptz [not null]

  indexes {
    reservation_id
    created_at
  }

  Note: 'Append-only reservation state transitions.'
}

//////////////////////////////////////////////////////////////
// EXPIRATION
//////////////////////////////////////////////////////////////

Table reservation.reservation_expirations {
  id uuid [pk]

  reservation_id uuid [not null]

  scheduled_at timestamptz [not null]

  processed_at timestamptz

  created_at timestamptz [not null]

  indexes {
    reservation_id
    scheduled_at
    processed_at
  }

  Note: 'Background expiration scheduler.'
}

