}

//////////////////////////////////////////////////////////////
// MEMBERSHIP
//////////////////////////////////////////////////////////////

TableGroup "Membership" {
  membership.membership_plans
  membership.membership_plan_features
  membership.membership_plan_benefits

  membership.memberships

  membership.membership_freezes

  membership.membership_usages

  membership.membership_transactions

  membership.passes

  membership.pass_entries

  membership.pass_transactions
}

//////////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////////

Enum membership_plan_type {
  subscription
  prepaid
  unlimited
}

Enum membership_status {
  pending
  active
  paused
  frozen
  expired
  canceled
}

Enum benefit_type {
  discount
  credit
  free_booking
  free_service
  access
}

Enum transaction_type {
  activation
  renewal
  upgrade
  downgrade
  freeze
  unfreeze
  cancellation
  expiration
  adjustment
}

Enum pass_status {
  active
  exhausted
  expired
  canceled
}

//////////////////////////////////////////////////////////////
// MEMBERSHIP PLAN
//////////////////////////////////////////////////////////////

Table membership.membership_plans {
  id uuid [pk]

  tenant_id uuid [not null]

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  membership_plan_type membership_plan_type [not null]

  duration_days int

  is_auto_renew boolean [not null, default: false]

  price decimal(18,2) [not null]

  currency varchar(10) [not null]

  is_active boolean [not null, default: true]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    is_active
    (tenant_id, code) [unique]
  }
}

//////////////////////////////////////////////////////////////
// PLAN FEATURES
//////////////////////////////////////////////////////////////

Table membership.membership_plan_features {
  id uuid [pk]

  membership_plan_id uuid [not null]

  feature_key varchar(100) [not null]

  feature_value jsonb

  created_at timestamptz [not null]

  indexes {
    membership_plan_id
    (membership_plan_id, feature_key) [unique]
  }
}

//////////////////////////////////////////////////////////////
// PLAN BENEFITS
//////////////////////////////////////////////////////////////

Table membership.membership_plan_benefits {
  id uuid [pk]

  membership_plan_id uuid [not null]

  benefit_type benefit_type [not null]

  benefit_key varchar(100) [not null]

  benefit_value jsonb

  priority int [not null, default: 100]

  created_at timestamptz [not null]

  indexes {
    membership_plan_id
    priority
  }
}

//////////////////////////////////////////////////////////////
// MEMBERSHIP
//////////////////////////////////////////////////////////////

Table membership.memberships {
  id uuid [pk]

  public_id varchar(26) [not null, unique]

  tenant_id uuid [not null]

  membership_no varchar(50) [not null]

  membership_plan_id uuid [not null]

  customer_id uuid [not null]

  status membership_status [not null]

  starts_at timestamptz [not null]

  expires_at timestamptz

  canceled_at timestamptz

  is_auto_renew boolean [not null]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    membership_no [unique]
    tenant_id
    customer_id
    membership_plan_id
    status
    expires_at
  }
}

//////////////////////////////////////////////////////////////
// FREEZE
//////////////////////////////////////////////////////////////

Table membership.membership_freezes {
  id uuid [pk]

  membership_id uuid [not null]

  starts_at timestamptz [not null]

  ends_at timestamptz [not null]

  reason text

  approved_by uuid

  created_at timestamptz [not null]

  indexes {
    membership_id
    starts_at
  }
}

//////////////////////////////////////////////////////////////
// USAGE
//////////////////////////////////////////////////////////////

Table membership.membership_usages {
  id uuid [pk]

  membership_id uuid [not null]

  booking_id uuid

  service_id uuid

  benefit_key varchar(100)

  quantity decimal(12,2) [not null]

  used_at timestamptz [not null]

  created_at timestamptz [not null]

  indexes {
    membership_id
    booking_id
    service_id
    used_at
  }

  Note: 'Immutable benefit usage history.'
}

//////////////////////////////////////////////////////////////
// TRANSACTIONS
//////////////////////////////////////////////////////////////

Table membership.membership_transactions {
  id uuid [pk]

  membership_id uuid [not null]

  transaction_type transaction_type [not null]

  reference_type varchar(100)

  reference_id uuid

  payload jsonb

  created_by uuid

  created_at timestamptz [not null]

  indexes {
    membership_id
    transaction_type
    created_at
  }

  Note: 'Append-only membership lifecycle.'
}

//////////////////////////////////////////////////////////////
// PASSES
//////////////////////////////////////////////////////////////

Table membership.passes {
  id uuid [pk]

  public_id varchar(26) [not null, unique]

  tenant_id uuid [not null]

  customer_id uuid [not null]

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  total_entries int [not null]

  remaining_entries int [not null]

  expires_at timestamptz

  status pass_status [not null]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    code [unique]
    tenant_id
    customer_id
    status
    expires_at
  }
}

//////////////////////////////////////////////////////////////
// PASS ENTRY
//////////////////////////////////////////////////////////////

Table membership.pass_entries {
  id uuid [pk]

  pass_id uuid [not null]

  booking_id uuid

  service_id uuid

  quantity int [not null]

  used_at timestamptz [not null]

  created_at timestamptz [not null]

  indexes {
    pass_id
    booking_id
    service_id
    used_at
  }

  Note: 'Immutable pass consumption.'
}

//////////////////////////////////////////////////////////////
// PASS TRANSACTIONS
//////////////////////////////////////////////////////////////

Table membership.pass_transactions {
  id uuid [pk]

  pass_id uuid [not null]

  transaction_type transaction_type [not null]

  reference_type varchar(100)

  reference_id uuid

  quantity int

  payload jsonb

  created_by uuid

  created_at timestamptz [not null]

  indexes {
    pass_id
    transaction_type
    created_at
  }

  Note: 'Append-only pass lifecycle.'
}

//////////////////////////////////////////////////////////////
// BILLING
//////////////////////////////////////////////////////////////

TableGroup "Billing" {
  billing.invoices
  billing.invoice_items

  billing.credit_notes
  billing.credit_note_items

  billing.debit_notes
  billing.debit_note_items
}

//////////////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////////////

TableGroup "Payment" {
  payment.payment_methods

  payment.payment_intents

  payment.payment_attempts

  payment.payments

  payment.payment_allocations

  payment.refunds

  payment.refund_items
}

//////////////////////////////////////////////////////////////
// LEDGER
//////////////////////////////////////////////////////////////

TableGroup "Ledger" {
  ledger.account_categories

  ledger.accounts

  ledger.journals

  ledger.journal_entries
}

//////////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////////

Enum invoice_status {
  draft
  issued
  partially_paid
  paid
  void
  canceled
}

Enum payment_intent_status {
  pending
  requires_action
  authorized
  succeeded
  failed
  canceled
}

Enum payment_status {
  pending
  completed
  failed
  refunded
  canceled
}

Enum refund_status {
  pending
  completed
  failed
  canceled
}

Enum payment_method_type {
  cash
  bank_transfer
  card
  wallet
  qr
  other
}

Enum ledger_account_type {
  asset
  liability
  equity
  revenue
  expense
}

//////////////////////////////////////////////////////////////
// INVOICE
//////////////////////////////////////////////////////////////

Table billing.invoices {
  id uuid [pk]

  public_id varchar(26) [not null, unique]

  tenant_id uuid [not null]

  invoice_no varchar(50) [not null]

  booking_id uuid

  customer_id uuid [not null]

  currency varchar(10) [not null]

  status invoice_status [not null]

  subtotal decimal(18,2) [not null]

  discount_amount decimal(18,2) [not null]

  tax_amount decimal(18,2) [not null]

  total_amount decimal(18,2) [not null]

  issued_at timestamptz

  due_at timestamptz

  paid_at timestamptz

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    invoice_no [unique]
    tenant_id
    customer_id
    booking_id
    status
    due_at
  }
}

Table billing.invoice_items {
  id uuid [pk]

  invoice_id uuid [not null]

  reference_type varchar(100)

  reference_id uuid

  description varchar(255)

  quantity decimal(12,2)

  unit_price decimal(18,2)

  subtotal decimal(18,2)

  tax_amount decimal(18,2)

  total_amount decimal(18,2)

  indexes {
    invoice_id
  }
}

//////////////////////////////////////////////////////////////
// CREDIT NOTE
//////////////////////////////////////////////////////////////

Table billing.credit_notes {
  id uuid [pk]

  invoice_id uuid [not null]

  credit_note_no varchar(50) [not null]

  reason text

  amount decimal(18,2) [not null]

  issued_at timestamptz

  created_at timestamptz [not null]

  indexes {
    credit_note_no [unique]
    invoice_id
  }
}

Table billing.credit_note_items {
  id uuid [pk]

  credit_note_id uuid [not null]

  invoice_item_id uuid

  amount decimal(18,2) [not null]

  indexes {
    credit_note_id
  }
}

//////////////////////////////////////////////////////////////
// DEBIT NOTE
//////////////////////////////////////////////////////////////

Table billing.debit_notes {
  id uuid [pk]

  invoice_id uuid [not null]

  debit_note_no varchar(50) [not null]

  reason text

  amount decimal(18,2) [not null]

  issued_at timestamptz

  created_at timestamptz [not null]

  indexes {
    debit_note_no [unique]
    invoice_id
  }
}

Table billing.debit_note_items {
  id uuid [pk]

  debit_note_id uuid [not null]

  invoice_item_id uuid

  amount decimal(18,2) [not null]

  indexes {
    debit_note_id
  }
}

//////////////////////////////////////////////////////////////
// PAYMENT METHOD
//////////////////////////////////////////////////////////////

Table payment.payment_methods {
  id uuid [pk]

  tenant_id uuid [not null]

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  payment_method_type payment_method_type [not null]

  configuration jsonb

  is_active boolean [not null, default: true]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    (tenant_id, code) [unique]
  }
}

//////////////////////////////////////////////////////////////
// PAYMENT INTENT
//////////////////////////////////////////////////////////////

Table payment.payment_intents {
  id uuid [pk]

  tenant_id uuid [not null]

  invoice_id uuid

  customer_id uuid [not null]

  payment_method_id uuid

  amount decimal(18,2) [not null]

  currency varchar(10) [not null]

  status payment_intent_status [not null]

  provider varchar(100)

  provider_reference varchar(255)

  expires_at timestamptz

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    invoice_id
    customer_id
    status
    provider_reference
  }
}

//////////////////////////////////////////////////////////////
// PAYMENT ATTEMPT
//////////////////////////////////////////////////////////////

Table payment.payment_attempts {
  id uuid [pk]

  payment_intent_id uuid [not null]

  attempt_no int [not null]

  request_payload jsonb

  response_payload jsonb

  is_success boolean [not null]

  error_message text

  attempted_at timestamptz [not null]

  indexes {
    payment_intent_id
    attempted_at
    (payment_intent_id, attempt_no) [unique]
  }

  Note: 'Immutable gateway attempt history.'
}

//////////////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////////////

Table payment.payments {
  id uuid [pk]

  tenant_id uuid [not null]

  payment_intent_id uuid

  payment_no varchar(50) [not null]

  status payment_status [not null]

  amount decimal(18,2) [not null]

  currency varchar(10) [not null]

  provider_reference varchar(255)

  completed_at timestamptz

  created_at timestamptz [not null]

  indexes {
    payment_no [unique]
    tenant_id
    payment_intent_id
    status
    completed_at
  }
}

//////////////////////////////////////////////////////////////
// PAYMENT ALLOCATION
//////////////////////////////////////////////////////////////

Table payment.payment_allocations {
  id uuid [pk]

  payment_id uuid [not null]

  invoice_id uuid [not null]

  allocated_amount decimal(18,2) [not null]

  created_at timestamptz [not null]

  indexes {
    payment_id
    invoice_id
    (payment_id, invoice_id) [unique]
  }
}

//////////////////////////////////////////////////////////////
// REFUND
//////////////////////////////////////////////////////////////

Table payment.refunds {
  id uuid [pk]

  payment_id uuid [not null]

  refund_no varchar(50) [not null]

  status refund_status [not null]

  amount decimal(18,2) [not null]

  reason text

  provider_reference varchar(255)

  completed_at timestamptz

  created_at timestamptz [not null]

  indexes {
    refund_no [unique]
    payment_id
    status
  }
}

Table payment.refund_items {
  id uuid [pk]

  refund_id uuid [not null]

  invoice_item_id uuid

  amount decimal(18,2) [not null]

  indexes {
    refund_id
  }
}

//////////////////////////////////////////////////////////////
// ACCOUNT CATEGORY
//////////////////////////////////////////////////////////////

Table ledger.account_categories {
  id uuid [pk]

  code varchar(50) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  ledger_account_type ledger_account_type [not null]

  indexes {
    code [unique]
  }
}

//////////////////////////////////////////////////////////////
// ACCOUNT
//////////////////////////////////////////////////////////////

Table ledger.accounts {
  id uuid [pk]

  tenant_id uuid [not null]

  account_category_id uuid [not null]

  code varchar(50) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  currency varchar(10) [not null]

  is_active boolean [not null, default: true]

  created_at timestamptz [not null]

  indexes {
    tenant_id
    account_category_id
    (tenant_id, code) [unique]
  }
}

//////////////////////////////////////////////////////////////
// JOURNAL
//////////////////////////////////////////////////////////////

Table ledger.journals {
  id uuid [pk]

  tenant_id uuid [not null]

  journal_no varchar(50) [not null]

  reference_type varchar(100)

  reference_id uuid

  description text

  journal_date timestamptz [not null]

  posted_at timestamptz

  created_at timestamptz [not null]

  indexes {
    journal_no [unique]
    tenant_id
    journal_date
  }

  Note: 'Immutable accounting journal.'
}

//////////////////////////////////////////////////////////////
// JOURNAL ENTRY
//////////////////////////////////////////////////////////////

Table ledger.journal_entries {
  id uuid [pk]

  journal_id uuid [not null]

  account_id uuid [not null]

  debit decimal(18,2) [not null, default: 0]

  credit decimal(18,2) [not null, default: 0]

  currency varchar(10) [not null]

  description varchar(255)

  created_at timestamptz [not null]

  indexes {
    journal_id
    account_id
  }

  Note: 'Double-entry accounting. Sum(debit)=Sum(credit).'
}

//////////////////////////////////////////////////////////////
// INTEGRATION
//////////////////////////////////////////////////////////////

TableGroup "Integration" {
  integration.providers

  integration.connections

  integration.credentials

  integration.webhook_endpoints

  integration.sync_profiles

  integration.sync_jobs

  integration.sync_executions

  integration.entity_mappings

  integration.integration_events

  integration.api_logs
}

//////////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////////

Enum provider_type {
  payment
  calendar
  communication
  crm
  erp
  accounting
  storage
  identity
  custom
}

Enum connection_status {
  pending
  connected
  disconnected
  suspended
}

Enum credential_type {
  api_key
  oauth2
  bearer
  basic
  jwt
}

Enum sync_direction {
  import
  export
  bidirectional
}

Enum sync_status {
  pending
  queued
  running
  completed
  failed
  canceled
}

Enum webhook_status {
  active
  disabled
}

Enum api_log_status {
  success
  failed
}

//////////////////////////////////////////////////////////////
// PROVIDER
//////////////////////////////////////////////////////////////

Table integration.providers {
  id uuid [pk]

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  provider_type provider_type [not null]

  base_url varchar(500)

  documentation_url varchar(500)

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    code [unique]
    provider_type
  }
}

//////////////////////////////////////////////////////////////
// CONNECTION
//////////////////////////////////////////////////////////////

Table integration.connections {
  id uuid [pk]

  tenant_id uuid [not null]

  provider_id uuid [not null]

  name_en varchar(255)

  name_vi varchar(255)

  status connection_status [not null]

  last_connected_at timestamptz

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    provider_id
    status
  }
}

//////////////////////////////////////////////////////////////
// CREDENTIAL
//////////////////////////////////////////////////////////////

Table integration.credentials {
  id uuid [pk]

  connection_id uuid [not null]

  credential_type credential_type [not null]

  encrypted_secret text [not null]

  refresh_token text

  expires_at timestamptz

  rotated_at timestamptz

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    connection_id
    expires_at
  }

  Note: 'Secrets encrypted using KMS/Vault.'
}

//////////////////////////////////////////////////////////////
// WEBHOOK
//////////////////////////////////////////////////////////////

Table integration.webhook_endpoints {
  id uuid [pk]

  connection_id uuid [not null]

  endpoint_url varchar(500) [not null]

  secret_hash varchar(255)

  status webhook_status [not null]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    connection_id
    status
  }
}

//////////////////////////////////////////////////////////////
// SYNC PROFILE
//////////////////////////////////////////////////////////////

Table integration.sync_profiles {
  id uuid [pk]

  connection_id uuid [not null]

  name_en varchar(255)

  name_vi varchar(255)

  sync_direction sync_direction [not null]

  source_entity varchar(100) [not null]

  destination_entity varchar(100) [not null]

  schedule varchar(100)

  is_enabled boolean [not null, default: true]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    connection_id
    is_enabled
  }
}

//////////////////////////////////////////////////////////////
// SYNC JOB
//////////////////////////////////////////////////////////////

Table integration.sync_jobs {
  id uuid [pk]

  sync_profile_id uuid [not null]

  status sync_status [not null]

  queued_at timestamptz

  started_at timestamptz

  finished_at timestamptz

  total_records int

  success_records int

  failed_records int

  created_at timestamptz [not null]

  indexes {
    sync_profile_id
    status
    queued_at
  }
}

//////////////////////////////////////////////////////////////
// SYNC EXECUTION
//////////////////////////////////////////////////////////////

Table integration.sync_executions {
  id uuid [pk]

  sync_job_id uuid [not null]

  entity_type varchar(100) [not null]

  entity_id uuid

  external_id varchar(255)

  status sync_status [not null]

  request_payload jsonb

  response_payload jsonb

  error_message text

  executed_at timestamptz [not null]

  indexes {
    sync_job_id
    status
    entity_type
    external_id
  }

  Note: 'Per-record synchronization.'
}

//////////////////////////////////////////////////////////////
// ENTITY MAPPING
//////////////////////////////////////////////////////////////

Table integration.entity_mappings {
  id uuid [pk]

  connection_id uuid [not null]

  entity_type varchar(100) [not null]

  internal_id uuid [not null]

  external_id varchar(255) [not null]

  synced_at timestamptz

  created_at timestamptz [not null]

  indexes {
    connection_id
    entity_type
    internal_id
    external_id
    (connection_id, entity_type, internal_id) [unique]
  }
}

//////////////////////////////////////////////////////////////
// INTEGRATION EVENT
//////////////////////////////////////////////////////////////

Table integration.integration_events {
  id uuid [pk]

  connection_id uuid [not null]

  direction sync_direction [not null]

  event_name varchar(255) [not null]

  payload jsonb [not null]

  is_processed boolean [not null, default: false]

  processed_at timestamptz

  created_at timestamptz [not null]

  indexes {
    connection_id
    direction
    is_processed
    created_at
  }

  Note: 'Inbound & outbound integration events.'
}

//////////////////////////////////////////////////////////////
// API LOG
//////////////////////////////////////////////////////////////

Table integration.api_logs {
  id uuid [pk]

  connection_id uuid [not null]

  method varchar(20) [not null]

  endpoint varchar(500) [not null]

  request_headers jsonb

  request_body jsonb

  response_status int

  response_body jsonb

  duration_ms bigint

  status api_log_status [not null]

  created_at timestamptz [not null]

  indexes {
    connection_id
    status
    response_status
    created_at
  }

  Note: 'Append-only external API audit log.'
}

//////////////////////////////////////////////////////////////
// REFERENCE
//////////////////////////////////////////////////////////////

TableGroup "Reference" {
  reference.locales
  reference.countries
  reference.country_translations
  reference.currencies
}

Table reference.locales {
  id uuid [pk]

  code varchar(16) [not null, unique]

  name varchar(255) [not null]

  native_name varchar(255) [not null]

  is_default boolean [not null, default: false]

  is_active boolean [not null, default: true]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    is_active
    is_default
  }

  Note: 'BCP-47. name = English, native_name = endonym. Not name_en/name_vi. vi is default. Accept-Language missing → vi.'
}

Table reference.countries {
  id uuid [pk]

  iso2 varchar(2) [not null]

  iso3 varchar(3)

  name_en varchar(255) [not null]

  name_vi varchar(255) [not null]

  phone_code varchar(10)

  is_active boolean [not null, default: true]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    iso2 [unique]
    iso3 [unique]
    is_active
  }

  Note: 'ISO 3166-1. Locale 3+: reference.country_translations.'
}

Table reference.country_translations {
  id uuid [pk]

  country_id uuid [not null]

  locale_id uuid [not null]

  name varchar(255) [not null]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    (country_id, locale_id) [unique]
  }

  Note: 'Template for locale 3+. Do not store en/vi here.'
}

Table reference.currencies {
  code varchar(3) [pk]

  name_en varchar(255) [not null]

  name_vi varchar(255) [not null]

  symbol varchar(10) [not null]

  decimal_places smallint [not null, default: 2]

  is_default boolean [not null, default: false]

  is_active boolean [not null, default: true]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    is_active
  }

  Note: 'ISO 4217. Locale 3+: add currency_translations.'
}

//////////////////////////////////////////////////////////////
// PLATFORM
//////////////////////////////////////////////////////////////

TableGroup "Platform" {
  platform.audit_logs

  platform.notifications

  platform.notification_templates

  platform.notification_deliveries

  platform.files

  platform.file_references

  platform.tags

  platform.tag_assignments

  platform.comments

  platform.activity_logs

  platform.saved_searches

  platform.custom_fields

  platform.custom_field_values
}

//////////////////////////////////////////////////////////////
// ANALYTICS
//////////////////////////////////////////////////////////////

TableGroup "Analytics" {
  analytics.metric_definitions

  analytics.metric_snapshots

  analytics.fact_bookings

  analytics.fact_revenue

  analytics.fact_customers

  analytics.fact_resources

  analytics.dimension_dates

  analytics.dimension_locations

  analytics.dimension_services

  analytics.dimension_customers
}

//////////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////////

Enum notification_channel {
  email
  sms
  push
  webhook
  in_app
}

Enum notification_status {
  pending
  queued
  sent
  delivered
  failed
  canceled
}

Enum file_storage {
  local
  s3
  gcs
  azure
}

Enum file_visibility {
  public
  private
}

Enum file_status {
  temporary
  active
  archived
}

Enum audit_actor_type {
  user
  staff
  system
  integration
}

Enum audit_log_activity_type {
  created
  updated
  deleted
  restored
  viewed
  exported
  imported
  status_change
  assign
  login
  logout
  other
}

Enum metric_type {
  counter
  gauge
  monetary
  percentage
  duration
}

//////////////////////////////////////////////////////////////
// AUDIT LOG
//////////////////////////////////////////////////////////////

Table platform.audit_logs {
  id uuid [pk]

  domain_event_id uuid [not null, unique]

  tenant_id uuid

  actor_type audit_actor_type

  actor_id uuid

  entity_type varchar(100) [not null]

  entity_id uuid [not null]

  action audit_log_activity_type [not null]

  before_data jsonb

  after_data jsonb

  ip_address inet

  user_agent text

  created_at timestamptz [not null]

  indexes {
    tenant_id
    entity_type
    entity_id
    action
    created_at
  }

  Note: 'Immutable audit trail. tenant_id NULL = platform-scoped identity action. domain_event_id enforces idempotent consumers.'
}

//////////////////////////////////////////////////////////////
// NOTIFICATION TEMPLATE
//////////////////////////////////////////////////////////////

Table platform.notification_templates {
  id uuid [pk]

  tenant_id uuid

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  notification_channel notification_channel [not null]

  subject varchar(255)

  content text [not null]

  is_active boolean [not null, default: true]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    code
    (tenant_id, code) [unique]
  }
}

//////////////////////////////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////////////////////////////

Table platform.notifications {
  id uuid [pk]

  tenant_id uuid [not null]

  template_id uuid

  recipient_type varchar(100)

  recipient_id uuid

  notification_channel notification_channel [not null]

  subject varchar(255)

  content text

  status notification_status [not null]

  scheduled_at timestamptz

  sent_at timestamptz

  created_at timestamptz [not null]

  indexes {
    tenant_id
    template_id
    recipient_id
    status
    scheduled_at
  }
}

//////////////////////////////////////////////////////////////
// DELIVERY
//////////////////////////////////////////////////////////////

Table platform.notification_deliveries {
  id uuid [pk]

  notification_id uuid [not null]

  provider varchar(100)

  provider_reference varchar(255)

  status notification_status [not null]

  response_payload jsonb

  delivered_at timestamptz

  created_at timestamptz [not null]

  indexes {
    notification_id
    status
  }
}

//////////////////////////////////////////////////////////////
// FILE
//////////////////////////////////////////////////////////////

Table platform.files {
  id uuid [pk]

  tenant_id uuid [not null]

  storage file_storage [not null]

  bucket varchar(255)

  path varchar(1000) [not null]

  original_name varchar(255)

  filename varchar(255)

  mime_type varchar(255)

  extension varchar(20)

  size bigint

  checksum varchar(255)

  visibility file_visibility [not null]

  status file_status [not null]

  created_by uuid

  created_at timestamptz [not null]

  deleted_at timestamptz

  indexes {
    tenant_id
    checksum
    mime_type
    visibility
    status
  }

  Note: 'Uploaded bytes only. External URLs stay on the owning business table.'
}

//////////////////////////////////////////////////////////////
// FILE REFERENCE
//////////////////////////////////////////////////////////////

Table platform.file_references {
  id uuid [pk]

  file_id uuid [not null]

  entity_type varchar(100) [not null]

  entity_id uuid [not null]

  created_at timestamptz [not null]

  indexes {
    file_id
    entity_type
    entity_id
    (file_id, entity_type, entity_id) [unique]
  }

  Note: 'entity_type is a known aggregate name (user, organization, location, resource, booking, ...).'
}

//////////////////////////////////////////////////////////////
// TAG
//////////////////////////////////////////////////////////////

Table platform.tags {
  id uuid [pk]

  tenant_id uuid [not null]

  name_en varchar(100)

  name_vi varchar(100)

  color varchar(20)

  created_at timestamptz [not null]

  indexes {
    tenant_id
    (tenant_id, name_en) [unique]
    (tenant_id, name_vi) [unique]
  }
}

//////////////////////////////////////////////////////////////
// TAG ASSIGNMENT
//////////////////////////////////////////////////////////////

Table platform.tag_assignments {
  id uuid [pk]

  tag_id uuid [not null]

  entity_type varchar(100) [not null]

  entity_id uuid [not null]

  created_at timestamptz [not null]

  indexes {
    tag_id
    entity_type
    entity_id
  }
}

//////////////////////////////////////////////////////////////
// COMMENT
//////////////////////////////////////////////////////////////

Table platform.comments {
  id uuid [pk]

  tenant_id uuid [not null]

  entity_type varchar(100) [not null]

  entity_id uuid [not null]

  author_id uuid

  content text [not null]

  parent_comment_id uuid

  created_at timestamptz [not null]

  updated_at timestamptz

  indexes {
    tenant_id
    entity_type
    entity_id
    parent_comment_id
  }
}

//////////////////////////////////////////////////////////////
// ACTIVITY LOG
//////////////////////////////////////////////////////////////

Table platform.activity_logs {
  id uuid [pk]

  tenant_id uuid [not null]

  actor_id uuid

  activity_type audit_log_activity_type [not null]

  entity_type varchar(100)

  entity_id uuid

  payload jsonb

  created_at timestamptz [not null]

  indexes {
    tenant_id
    actor_id
    activity_type
    created_at
  }
}

//////////////////////////////////////////////////////////////
// SAVED SEARCH
//////////////////////////////////////////////////////////////

Table platform.saved_searches {
  id uuid [pk]

  tenant_id uuid [not null]

  user_id uuid [not null]

  name_en varchar(255)

  name_vi varchar(255)

  filters jsonb [not null]

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    tenant_id
    user_id
  }
}

//////////////////////////////////////////////////////////////
// CUSTOM FIELD
//////////////////////////////////////////////////////////////

Table platform.custom_fields {
  id uuid [pk]

  tenant_id uuid [not null]

  entity_type varchar(100) [not null]

  code varchar(100) [not null]

  name_en varchar(255)

  name_vi varchar(255)

  data_type varchar(50) [not null]

  configuration jsonb

  created_at timestamptz [not null]

  indexes {
    tenant_id
    entity_type
    (tenant_id, entity_type, code) [unique]
  }
}

//////////////////////////////////////////////////////////////
// CUSTOM FIELD VALUE
//////////////////////////////////////////////////////////////

Table platform.custom_field_values {
  id uuid [pk]

  custom_field_id uuid [not null]

  entity_id uuid [not null]

  value jsonb

  created_at timestamptz [not null]

  indexes {
    custom_field_id
    entity_id
    (custom_field_id, entity_id) [unique]
  }
}

//////////////////////////////////////////////////////////////
// METRIC DEFINITION
//////////////////////////////////////////////////////////////

Table analytics.metric_definitions {
  id uuid [pk]

  code varchar(100) [not null]

  name_en varchar(255) [not null]

  name_vi varchar(255) [not null]

  metric_type metric_type [not null]

  unit varchar(50)

  indexes {
    code [unique]
  }
}

//////////////////////////////////////////////////////////////
// METRIC SNAPSHOT
//////////////////////////////////////////////////////////////

Table analytics.metric_snapshots {
  id uuid [pk]

  tenant_id uuid [not null]

  metric_definition_id uuid [not null]

  dimension_key varchar(255)

  snapshot_date date [not null]

  metric_value decimal(24,6) [not null]

  created_at timestamptz [not null]

  indexes {
    tenant_id
    metric_definition_id
    snapshot_date
  }
}

//////////////////////////////////////////////////////////////
// FACT TABLES
//////////////////////////////////////////////////////////////

Table analytics.fact_bookings {
  id bigint [pk, increment]

  tenant_id uuid [not null]

  booking_id uuid [not null]

  date_key date [not null]

  customer_id uuid

  location_id uuid

  service_id uuid

  revenue decimal(18,2)

  duration_minutes int

  created_at timestamptz [not null]

  indexes {
    tenant_id
    date_key
    service_id
    location_id
  }
}

Table analytics.fact_revenue {
  id bigint [pk, increment]

  tenant_id uuid [not null]

  payment_id uuid

  invoice_id uuid

  date_key date [not null]

  amount decimal(18,2)

  tax_amount decimal(18,2)

  created_at timestamptz [not null]

  indexes {
    tenant_id
    date_key
  }
}

Table analytics.fact_customers {
  id bigint [pk, increment]

  tenant_id uuid [not null]

  customer_id uuid [not null]

  date_key date [not null]

  bookings int

  revenue decimal(18,2)

  visits int

  created_at timestamptz [not null]

  indexes {
    tenant_id
    customer_id
    date_key
  }
}

Table analytics.fact_resources {
  id bigint [pk, increment]

  tenant_id uuid [not null]

  resource_id uuid [not null]

  date_key date [not null]

  utilization_rate decimal(8,2)

  booking_count int

  occupied_minutes int

  created_at timestamptz [not null]

  indexes {
    tenant_id
    resource_id
    date_key
  }
}

//////////////////////////////////////////////////////////////
// DIMENSIONS
//////////////////////////////////////////////////////////////

Table analytics.dimension_dates {
  date_key date [pk]

  year int

  quarter int

  month int

  week int

  day int

  weekday int
}

Table analytics.dimension_locations {
  id uuid [pk]

  location_name varchar(255)

  city varchar(255)

  country varchar(255)
}

Table analytics.dimension_services {
  id uuid [pk]

  service_name varchar(255)

  category varchar(255)
}

Table analytics.dimension_customers {
  id uuid [pk]

  customer_type varchar(100)

  segment varchar(100)
}

