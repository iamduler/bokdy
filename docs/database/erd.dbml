  staff
}

Enum assignment_type {
  resource
  coach
  staff
}

Enum workflow_status {
  pending
  running
  completed
  canceled
}

Enum check_in_status {
  pending
  checked_in
  checked_out
  no_show
}

//////////////////////////////////////////////////////////////
// BOOKING
//////////////////////////////////////////////////////////////

Table booking.bookings {
  id uuid [pk]

  public_id varchar(26) [not null, unique]

  tenant_id uuid [not null]

  booking_no varchar(50) [not null]

  reservation_id uuid

  customer_id uuid [not null]

  location_id uuid [not null]

  status booking_status [not null]

  currency varchar(10) [not null]

  subtotal decimal(18,2) [not null, default: 0]

  discount_amount decimal(18,2) [not null, default: 0]

  tax_amount decimal(18,2) [not null, default: 0]

  total_amount decimal(18,2) [not null, default: 0]

  confirmed_at timestamptz

  canceled_at timestamptz

  completed_at timestamptz

  created_by uuid

  created_at timestamptz [not null]

  updated_at timestamptz [not null]

  indexes {
    booking_no [unique]
    tenant_id
    reservation_id
    customer_id
    location_id
    status
    completed_at
  }
}

//////////////////////////////////////////////////////////////
// BOOKING ITEMS
//////////////////////////////////////////////////////////////

Table booking.booking_items {
  id uuid [pk]

  booking_id uuid [not null]

  service_id uuid [not null]

  starts_at timestamptz [not null]

  ends_at timestamptz [not null]

  duration_minutes int [not null]

  quantity int [not null, default: 1]

  unit_price decimal(18,2) [not null]

  subtotal decimal(18,2) [not null]

  discount_amount decimal(18,2) [not null, default: 0]

  tax_amount decimal(18,2) [not null, default: 0]

  total_amount decimal(18,2) [not null]

  created_at timestamptz [not null]

  indexes {
    booking_id
    service_id
    starts_at
  }
}

//////////////////////////////////////////////////////////////
// BOOKING RESOURCES
//////////////////////////////////////////////////////////////

Table booking.booking_resources {
  id uuid [pk]

  booking_item_id uuid [not null]

  resource_id uuid [not null]

  quantity int [not null, default: 1]

  starts_at timestamptz [not null]

  ends_at timestamptz [not null]

  created_at timestamptz [not null]

  indexes {
    booking_item_id
    resource_id
    starts_at
  }
}

//////////////////////////////////////////////////////////////
// PARTICIPANTS
//////////////////////////////////////////////////////////////

Table booking.booking_participants {
  id uuid [pk]

  booking_item_id uuid [not null]

  customer_id uuid

  participant_role participant_role [not null]

  full_name varchar(255) [not null]

  phone varchar(30)

  email varchar(255)

  is_checked_in boolean [not null, default: false]

  created_at timestamptz [not null]

  indexes {
    booking_item_id
    customer_id
    participant_role
  }
}

//////////////////////////////////////////////////////////////
// ASSIGNMENTS
//////////////////////////////////////////////////////////////

Table booking.booking_assignments {
  id uuid [pk]

  booking_item_id uuid [not null]

  assignment_type assignment_type [not null]

  resource_id uuid

  staff_member_id uuid

  assigned_at timestamptz [not null]

  assigned_by uuid

  unassigned_at timestamptz

  created_at timestamptz [not null]

  indexes {
    booking_item_id
    assignment_type
    resource_id
    staff_member_id
  }

  Note: 'Assignment history for coaches, staff and resources.'
}

//////////////////////////////////////////////////////////////
// CHECK IN
//////////////////////////////////////////////////////////////

Table booking.check_ins {
  id uuid [pk]

  booking_participant_id uuid [not null]

  status check_in_status [not null]

  checked_in_at timestamptz

  checked_out_at timestamptz

  verified_by uuid

  created_at timestamptz [not null]

  indexes {
    booking_participant_id
    status
  }
}

//////////////////////////////////////////////////////////////
// WORKFLOW
//////////////////////////////////////////////////////////////

Table booking.booking_workflows {
