description: App controls use @bokdy/ui shadcn primitives, never native select/date/time/textarea
globs:
  - packages/ui/src/**/*.{tsx,ts}
  - apps/**/components/**/*.tsx
  - apps/**/app/**/*.tsx
alwaysApply: true
